# PostgreSQL
POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=change-me

# Spring profile
SPRING_PROFILES_ACTIVE=production

# Backend datasource inside docker-compose network
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/quiz
SPRING_DATASOURCE_USERNAME=quiz
SPRING_DATASOURCE_PASSWORD=change-me

# Backend HTTP port inside container
SERVER_PORT=8080

# RSA keys for JWT signing and verification.
# For Docker/VPS use file: paths mounted into the backend container.
RSA_PUBLIC_KEY=file:/run/secrets/jwt-public.pem
RSA_PRIVATE_KEY=file:/run/secrets/jwt-private.pem

# Host paths mounted into backend container.
JWT_PUBLIC_KEY_PATH=./deploy/secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./deploy/secrets/jwt-private.pem

# Browser origins allowed to call backend directly.
# If frontend and backend are served from the same domain through reverse proxy,
# this can stay as the public domain.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.com

# Public HTTP port for frontend reverse proxy container.
# For first VPS smoke run use 80. HTTPS will be configured later.
FRONTEND_PORT=80
